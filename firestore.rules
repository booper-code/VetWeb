rules_version = '2';

// VetCloudPro multi-clinic authorization.
//
// Canonical membership: clinics/{clinicId}/members/{uid}
// User's clinic-picker index: users/{uid}/clinics/{clinicId}
// Owner-created clinics and accepted invitations must write both membership
// records atomically. These rules, not the client UI, enforce every role check.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function memberPath(clinicId, uid) {
      return /databases/$(database)/documents/clinics/$(clinicId)/members/$(uid);
    }

    function userClinicPath(uid, clinicId) {
      return /databases/$(database)/documents/users/$(uid)/clinics/$(clinicId);
    }

    function invitationPath(clinicId, invitationId) {
      return /databases/$(database)/documents/clinics/$(clinicId)/invitations/$(invitationId);
    }

    function clinicPath(clinicId) {
      return /databases/$(database)/documents/clinics/$(clinicId);
    }

    function clinicRoleIs(clinicId, role) {
      return signedIn()
        && request.auth.uid is string
        && request.auth.uid.size() > 0
        && get(memberPath(clinicId, request.auth.uid)) != null
        && get(memberPath(clinicId, request.auth.uid)).data.role == role;
    }

    function isClinicMember(clinicId) {
      return canEditClinic(clinicId);
    }

    function canEditClinic(clinicId) {
      return signedIn() && canEditRole(get(memberPath(clinicId, request.auth.uid)));
    }

    function canEditRole(member) {
      return member != null && member.data.role in ['owner', 'member', 'editor', 'viewer'];
    }

    function isClinicOwner(clinicId) {
      return clinicRoleIs(clinicId, 'owner')
        && get(clinicPath(clinicId)).data.ownerId == request.auth.uid;
    }

    // Creating a clinic is allowed only when the same atomic batch also creates
    // its first owner membership and the owner's clinic-picker entry.
    function validNewClinic(clinicId) {
      let memberAfter = getAfter(memberPath(clinicId, request.auth.uid));
      let indexAfter = getAfter(userClinicPath(request.auth.uid, clinicId));
      return signedIn()
        && request.resource.data.keys().hasAll(['name', 'ownerId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && memberAfter.data.uid == request.auth.uid
        && memberAfter.data.role == 'owner'
        && indexAfter.data.clinicId == clinicId
        && indexAfter.data.clinicName == request.resource.data.name
        && indexAfter.data.role == 'owner';
    }

    function validOwnerMemberBootstrap(clinicId, memberUid) {
      let clinicAfter = getAfter(
        /databases/$(database)/documents/clinics/$(clinicId)
      );
      let indexAfter = getAfter(userClinicPath(memberUid, clinicId));
      return signedIn()
        && memberUid == request.auth.uid
        && clinicAfter.data.ownerId == request.auth.uid
        && indexAfter.data.clinicId == clinicId
        && indexAfter.data.clinicName == clinicAfter.data.name
        && indexAfter.data.role == 'owner';
    }

    function validOwnerIndexBootstrap(clinicId, uid) {
      let clinicAfter = getAfter(
        /databases/$(database)/documents/clinics/$(clinicId)
      );
      let memberAfter = getAfter(memberPath(clinicId, uid));
      return signedIn()
        && uid == request.auth.uid
        && clinicAfter.data.ownerId == request.auth.uid
        && memberAfter.data.uid == uid
        && memberAfter.data.role == 'owner';
    }

    // The invite must already exist and be pending, and the same transaction
    // must mark it accepted while creating the two corresponding memberships.
    function validInviteClaim(clinicId, uid, inviteId) {
      let path = invitationPath(clinicId, inviteId);
      return verifiedEmail()
        && uid == request.auth.uid
        && inviteId is string
        && get(path).data.clinicId == clinicId
        && get(path).data.status == 'pending'
        && get(path).data.email == request.auth.token.email
        && get(path).data.role in ['member', 'editor']
        && get(path).data.expiresAt > request.time
        && getAfter(path).data.status == 'accepted'
        && getAfter(path).data.acceptedBy == uid
        && getAfter(path).data.acceptedAt == request.time;
    }

    function validInviteAcceptanceUpdate(clinicId, inviteId) {
      let memberAfter = getAfter(memberPath(clinicId, request.auth.uid));
      let indexAfter = getAfter(userClinicPath(request.auth.uid, clinicId));
      return verifiedEmail()
        && resource.data.clinicId == clinicId
        && resource.data.status == 'pending'
        && resource.data.role in ['member', 'editor']
        && resource.data.email == request.auth.token.email
        && request.time < resource.data.expiresAt
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'acceptedBy', 'acceptedAt'])
        && memberAfter.data.role == 'member'
        && memberAfter.data.email == request.auth.token.email
        && memberAfter.data.invitationId == inviteId
        && indexAfter.data.role == 'member'
        && indexAfter.data.clinicName == resource.data.clinicName
        && indexAfter.data.invitationId == inviteId;
    }

    // Clinic documents are not enumerable. A member can read their clinic;
    // creation requires the owner/member/index bootstrap batch above.
    match /clinics/{clinicId} {
      allow get: if isClinicMember(clinicId);
      allow list: if false;
      allow create: if validNewClinic(clinicId);

      // Members can change clinic settings. The recorded owner is permanent.
      allow update: if isClinicMember(clinicId)
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 100
          ) || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aiEnabled'])
            && request.resource.data.aiEnabled is bool
          ) || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imageUploadsEnabled'])
            && request.resource.data.imageUploadsEnabled is bool
          )
        );
      allow delete: if false;

      match /members/{memberUid} {
        allow get, list: if isClinicMember(clinicId);

        allow create: if (
          request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt'])
          && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt'])
          && request.resource.data.uid == memberUid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.displayName is string
          && request.resource.data.role == 'owner'
          && request.resource.data.createdAt == request.time
          && validOwnerMemberBootstrap(clinicId, memberUid)
        ) || (
          request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'joinedAt', 'invitationId'])
          && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'joinedAt', 'invitationId'])
          && request.resource.data.uid == memberUid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.displayName is string
          && request.resource.data.role == 'member'
          && request.resource.data.joinedAt == request.time
          && validInviteClaim(clinicId, memberUid, request.resource.data.invitationId)
        );

        allow update: if false;

        allow delete: if isClinicOwner(clinicId)
          && memberUid != request.auth.uid
          && resource.data.role != 'owner'
          && !existsAfter(userClinicPath(memberUid, clinicId));
      }

      match /invitations/{inviteId} {
        allow get, list: if isClinicMember(clinicId);
        allow get: if verifiedEmail()
          && resource.data.email == request.auth.token.email
          && resource.data.status == 'pending'
          && request.time < resource.data.expiresAt;

        allow create: if isClinicOwner(clinicId)
          && request.resource.data.keys().hasAll([
            'clinicId', 'clinicName', 'email', 'role', 'status',
            'createdBy', 'createdByEmail', 'createdAt', 'expiresAt'
          ])
          && request.resource.data.keys().hasOnly([
            'clinicId', 'clinicName', 'email', 'role', 'status',
            'createdBy', 'createdByEmail', 'createdAt', 'expiresAt'
          ])
          && request.resource.data.clinicId == clinicId
          && request.resource.data.clinicName == get(
            /databases/$(database)/documents/clinics/$(clinicId)
          ).data.name
          && request.resource.data.email is string
          && request.resource.data.email.size() > 0
          && request.resource.data.role == 'member'
          && request.resource.data.status == 'pending'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdByEmail == request.auth.token.email
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');

        allow update: if (
          isClinicOwner(clinicId)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'revoked'
          && request.resource.data.revokedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'revokedAt'])
        ) || validInviteAcceptanceUpdate(clinicId, inviteId);
        allow delete: if false;
      }

      // Metadata only: a permanent head prevents replay and deleted-ID reuse.
      // All three writes validate the same before/after entity transition.
      function auditedMutation(entityType, entityId) {
        let entity = /databases/$(database)/documents/clinics/$(clinicId)/$(entityType)/$(entityId);
        let head = /databases/$(database)/documents/clinics/$(clinicId)/auditHeads/$(entityType + '_' + entityId);
        let next = getAfter(head).data;
        let event = /databases/$(database)/documents/clinics/$(clinicId)/auditEvents/$(next.eventId);
        let oldRevision = exists(entity) ? get(entity).data.get('revision', 0) : 0;
        return canEditClinic(clinicId)
          && entityType in ['patients', 'inventory', 'consultations', 'appointments', 'staff', 'payProfiles', 'payrollPeriods']
          && next.keys().hasOnly(['actorUid', 'action', 'entityType', 'entityId', 'time', 'seq', 'eventId'])
          && next.actorUid == request.auth.uid
          && next.entityType == entityType && next.entityId == entityId
          && next.time == request.time
          && next.seq is int && next.seq == oldRevision + 1
          && next.eventId is string
          && !exists(event) && getAfter(event).data == next
          && (exists(head) ? get(head).data.seq == oldRevision : oldRevision == 0)
          && (
            (next.action == 'create' && !exists(entity) && !exists(head)
              && existsAfter(entity) && getAfter(entity).data.revision == next.seq)
            || (next.action == 'update' && exists(entity) && existsAfter(entity)
              && getAfter(entity).data.revision == next.seq)
            || (next.action == 'delete' && exists(entity) && !existsAfter(entity))
          );
      }

      match /auditHeads/{headId} {
        allow read: if isClinicMember(clinicId);
        allow create, update: if headId == request.resource.data.entityType + '_' + request.resource.data.entityId
          && auditedMutation(request.resource.data.entityType, request.resource.data.entityId);
        allow delete: if false;
      }

      match /auditEvents/{eventId} {
        allow read: if isClinicMember(clinicId);
        allow create: if request.resource.data.eventId == eventId
          && request.resource.data == getAfter(
            /databases/$(database)/documents/clinics/$(clinicId)/auditHeads/$(request.resource.data.entityType + '_' + request.resource.data.entityId)
          ).data
          && auditedMutation(request.resource.data.entityType, request.resource.data.entityId);
        allow update, delete: if false;
      }

      function billingEntryPath(entryId) {
        return /databases/$(database)/documents/clinics/$(clinicId)/billingEntries/$(entryId);
      }

      function billingMinor(value) {
        return value is int && value >= 0 && value <= 9007199254740991;
      }

      function billingTime(value) {
        return value is int && value >= 662659200000 && value <= request.time.toMillis();
      }

      function billingMidnight(value) {
        return billingTime(value) && (value + 28800000) % 86400000 == 0;
      }

      function billingText(value, limit) {
        return value is string && value.size() <= limit && value.matches('(?s).*\\S.*');
      }

      function billingStockChanged(move, entryId) {
        let path = /databases/$(database)/documents/clinics/$(clinicId)/inventory/$(move.itemCode);
        let before = get(path).data;
        let after = getAfter(path).data;
        return after.stock is int && after.stock >= 0
          && after.stock == before.stock + move.quantityDelta
          && after.revision == before.get('revision', 0) + 1
          && after.billingStockEntryId == entryId && before.get('billingStockEntryId', null) != entryId
          && after.diff(before).affectedKeys().hasOnly(['stock', 'revision', 'id', 'billingStockEntryId'])
          && after.id == move.itemCode;
      }

      function billingStockMovesApplied(moves, entryId) {
        return moves.size() < 1 || (billingStockChanged(moves[0], entryId)
          && (moves.size() == 1 || (moves[0].itemCode != moves[1].itemCode && billingStockChanged(moves[1], entryId))));
      }

      function billableCategory(category) {
        return category in ['Medicine', 'Supplies'];
      }

      function billingCatalogLine(line) {
        let item = get(/databases/$(database)/documents/clinics/$(clinicId)/inventory/$(line.itemCode)).data;
        return line.keys().hasOnly(['itemCode', 'itemName', 'category', 'quantity', 'unitPriceMinor'])
          && item.itemCode == line.itemCode && item.itemName == line.itemName
          && item.category == line.category && line.category in ['Medicine', 'Supplies', 'Service', 'Grooming']
          && line.quantity is int && line.quantity > 0 && line.quantity <= 9007199254740991
          && billingMinor(line.unitPriceMinor) && item.sellingPrice == line.unitPriceMinor / 100.0
          && billingMinor(line.unitPriceMinor * line.quantity);
      }

      function billedLineMoves(line) {
        return billableCategory(line.category) ? [{'itemCode': line.itemCode, 'quantityDelta': -line.quantity}] : [];
      }

      function billingCharge(entry, entryId) {
        let lines = entry.lines;
        return lines is list && lines.size() in [1, 2]
          && billingCatalogLine(lines[0])
          && (lines.size() == 1 || (lines[1].itemCode != lines[0].itemCode && billingCatalogLine(lines[1])))
          && entry.amountMinor == lines[0].unitPriceMinor * lines[0].quantity
            + (lines.size() == 2 ? lines[1].unitPriceMinor * lines[1].quantity : 0)
          && entry.stockMoves == billedLineMoves(lines[0]).concat(lines.size() == 2 ? billedLineMoves(lines[1]) : [])
          && billingStockMovesApplied(entry.stockMoves, entryId);
      }

      function allowedBillingOpening(entry, legacyBalance) {
        return billingTime(entry.cutoffMs) && billingText(entry.source, 120)
          && entry.reason is string && entry.reason.size() <= 500
          && (entry.legacyOriginalMinor == null
            || (billingMinor(entry.legacyOriginalMinor) && legacyBalance == entry.legacyOriginalMinor / 100.0))
          && ((entry.legacyOriginalMinor != null && entry.legacyOriginalMinor == entry.amountMinor)
            || billingText(entry.reason, 500));
      }

      function reviewedBillingPayment(entry, old, patient) {
        return entry.amountMinor > 0 && entry.stockMoves == []
          && entry.method in ['cash', 'e-wallet', 'bank-transfer', 'card', 'other']
          && entry.timeZone == 'Asia/Manila' && billingTime(entry.occurredAtMs) && billingMidnight(entry.businessDayMs)
          && entry.occurredAtMs >= entry.businessDayMs && entry.occurredAtMs < entry.businessDayMs + 86400000
          && (old.cutoffKind == 'reviewed' ? entry.occurredAtMs > old.cutoffMs : entry.occurredAtMs >= old.cutoffMs)
          && entry.reference is string && entry.reference.size() <= 120 && entry.note is string && entry.note.size() <= 500
          && entry.patientName == patient.get('name', 'Unnamed patient')
          && entry.clinicName == get(clinicPath(clinicId)).data.name;
      }

      function returnedBillingMoves(moves, index) {
        return moves.size() <= index ? [] : [{'itemCode': moves[index].itemCode, 'quantityDelta': -moves[index].quantityDelta}];
      }

      function allowedBillingReversal(entry, entryId) {
        let original = get(billingEntryPath(entry.originalEntryId)).data;
        return billingText(entry.reason, 500) && entry.returnStock is bool
          && entryId == 'reverse_' + entry.originalEntryId && original.seq < entry.seq
          && original.patientId == entry.patientId && original.clinicId == clinicId && original.kind in ['charge', 'payment', 'unitemized-settlement']
          && entry.amountMinor == original.amountMinor
          && entry.balanceAfterMinor == entry.balanceBeforeMinor + (original.kind == 'charge' ? -entry.amountMinor : entry.amountMinor)
          && (entry.returnStock
            ? original.kind == 'charge' && original.stockMoves.size() > 0
              && entry.stockMoves == returnedBillingMoves(original.stockMoves, 0).concat(returnedBillingMoves(original.stockMoves, 1))
              && billingStockMovesApplied(entry.stockMoves, entryId)
            : entry.stockMoves == []);
      }

      function billingEntryFields(entry) {
        let common = ['clinicId', 'patientId', 'actorUid', 'recordedAt', 'requestFingerprint', 'seq', 'kind',
          'balanceBeforeMinor', 'balanceAfterMinor', 'amountMinor', 'stockMoves'];
        let specific = entry.kind == 'opening' ? ['cutoffMs', 'source', 'reason', 'legacyOriginalMinor']
          : entry.kind == 'opening-correction' ? ['source', 'reason']
          : entry.kind == 'payment' ? ['method', 'occurredAtMs', 'businessDayMs', 'timeZone', 'reference', 'note', 'clinicName', 'patientName']
          : entry.kind == 'unitemized-settlement' ? ['businessDayMs']
          : entry.kind == 'charge' ? ['lines'] : ['originalEntryId', 'reason', 'returnStock'];
        // Each allowed field is read by the applicable transition. A missing field fails that transition.
        return entry.keys().hasOnly(common.concat(specific))
          && entry.stockMoves is list && entry.stockMoves.size() <= 2
          && entry.requestFingerprint is string && entry.requestFingerprint.matches('[a-f0-9]{64}');
      }

      function billingAdvance(entry, old, next, patient, entryId) {
        return old == null
          ? (entry.kind == 'opening' && allowedBillingOpening(entry, patient.get('balance', null))
              && entry.stockMoves == [] && next.cutoffKind == 'reviewed' && next.cutoffMs == entry.cutoffMs
              && next.openingMinor == entry.amountMinor && next.balanceMinor == entry.amountMinor)
            || (entry.kind == 'charge' && patient.get('balance', null) == 0 && next.openingMinor == 0
              && next.cutoffKind == 'implicit-zero' && billingMidnight(next.cutoffMs)
              && request.time.toMillis() < next.cutoffMs + 86400000
              && next.balanceMinor == entry.amountMinor && billingCharge(entry, entryId))
          : next.cutoffKind == old.cutoffKind && next.cutoffMs == old.cutoffMs && (
            (entry.kind == 'opening-correction' && old.cutoffKind == 'reviewed' && entry.stockMoves == [] && billingText(entry.source, 120)
              && billingText(entry.reason, 500) && next.openingMinor == entry.amountMinor
              && next.balanceMinor == old.balanceMinor + next.openingMinor - old.openingMinor)
            || (next.openingMinor == old.openingMinor && (
               (entry.kind == 'payment' && next.balanceMinor == old.balanceMinor - entry.amountMinor && reviewedBillingPayment(entry, old, patient))
               || (entry.kind == 'unitemized-settlement' && entry.amountMinor > 0 && entry.amountMinor == old.balanceMinor
                 && next.balanceMinor == 0 && entry.stockMoves == [] && billingMidnight(entry.businessDayMs)
                 && entry.businessDayMs + 86400000 > old.cutoffMs)
              || (entry.kind == 'charge' && next.balanceMinor == old.balanceMinor + entry.amountMinor && billingCharge(entry, entryId))
              || (entry.kind == 'reversal' && allowedBillingReversal(entry, entryId))
            ))
          );
      }

      function validBillingEntry(entry, entryId) {
        let path = /databases/$(database)/documents/clinics/$(clinicId)/patients/$(entry.patientId);
        let patient = get(path).data;
        let old = patient.get('billing', null);
        let next = getAfter(path).data.billing;
        return billingEntryFields(entry)
          && entry.clinicId == clinicId && entry.actorUid == request.auth.uid && entry.recordedAt == request.time
          && (entry.kind == 'reversal' || entryId.matches('[A-Za-z0-9-]{1,100}'))
          && next.keys().hasOnly(['lastEntryId', 'seq', 'openingMinor', 'balanceMinor', 'cutoffMs', 'cutoffKind'])
          && next.lastEntryId == entryId && next.seq == entry.seq && entry.seq is int
          && entry.seq == (old == null ? 1 : old.seq + 1)
          && billingMinor(next.openingMinor) && billingMinor(next.balanceMinor) && billingMinor(entry.amountMinor)
          && entry.balanceBeforeMinor == (old == null ? 0 : old.balanceMinor) && entry.balanceAfterMinor == next.balanceMinor
          && billingAdvance(entry, old, next, patient, entryId);
      }

      function patientBillingAdvanced(patientId) {
        let next = request.resource.data.billing;
        let entry = getAfter(billingEntryPath(next.lastEntryId)).data;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['billing', 'id', 'revision'])
          && entry.patientId == patientId && entry.seq == next.seq && entry.recordedAt == request.time;
      }

      // A posted payment can be recovered only by the account that submitted
      // it, in the same clinic and patient. The marker is created with the
      // payment and removed after the client reads the saved receipt.
      match /billingPaymentRecovery/{uid}/patients/{patientId} {
        function ownsRecovery() {
          return canEditClinic(clinicId) && request.auth.uid == uid;
        }

        function matchesPostedPayment(data) {
          let receipt = getAfter(/databases/$(database)/documents/clinics/$(clinicId)/billingEntries/$(data.operationId)).data;
          return receipt.kind == 'payment'
            && receipt.actorUid == uid
            && receipt.patientId == patientId
            && receipt.recordedAt == request.time
            && receipt.amountMinor == data.draft.amountMinor
            && receipt.method == data.draft.method
            && receipt.occurredAtMs == data.draft.occurredAtMs;
        }

        allow get, delete: if ownsRecovery();
        allow create: if ownsRecovery()
          && request.resource.data.keys().hasOnly(['operationId', 'expectedPatientRevision', 'draft'])
          && request.resource.data.operationId.matches('^[A-Za-z0-9-]{1,100}$')
          && request.resource.data.expectedPatientRevision is int
          && request.resource.data.expectedPatientRevision >= 0
          && request.resource.data.draft.keys().hasOnly(['kind', 'amountMinor', 'method', 'occurredAtMs', 'reference', 'note'])
          && request.resource.data.draft.kind == 'payment'
          && request.resource.data.draft.get('reference', '') is string
          && request.resource.data.draft.get('reference', '').size() <= 120
          && request.resource.data.draft.get('note', '') is string
          && request.resource.data.draft.get('note', '').size() <= 500
          && matchesPostedPayment(request.resource.data);
        allow list, update: if false;
      }

      match /billingEntries/{entryId} {
        allow read: if canEditClinic(clinicId);
        allow create: if canEditClinic(clinicId) && validBillingEntry(request.resource.data, entryId);
        allow update, delete: if false;
      }

      match /patients/{patientId} {
        allow read: if isClinicMember(clinicId);
        allow create: if auditedMutation('patients', patientId)
          && !request.resource.data.keys().hasAny(['billing'])
          && request.resource.data.get('balance', 0) == 0
          && request.resource.data.get('billableItems', []) == [];
        allow update: if auditedMutation('patients', patientId)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['balance', 'billableItems', 'billing'])
            || patientBillingAdvanced(patientId));
        allow delete: if auditedMutation('patients', patientId)
          && !resource.data.keys().hasAny(['billing'])
          && resource.data.get('balance', 0) == 0 && resource.data.get('billableItems', []) == [];
      }

      function billingInventoryReference(itemId) {
        let entry = getAfter(billingEntryPath(request.resource.data.billingStockEntryId)).data;
        let moves = entry.stockMoves;
        return entry.recordedAt == request.time
          && (moves[0].itemCode == itemId || (moves.size() == 2 && moves[1].itemCode == itemId));
      }

      function validExpiryCalendar(parts) {
        let year = int(parts[0]);
        let month = int(parts[1]);
        let day = int(parts[2]);
        let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
        let limit = month == 2 ? (leap ? 29 : 28) : (month in [4, 6, 9, 11] ? 30 : 31);
        return year > 0 && month >= 1 && month <= 12 && day >= 1 && day <= limit;
      }

      function validInventoryExpiry(data) {
        let date = data.get('expiryDate', null);
        return !data.keys().hasAny(['expiryDate'])
          || (data.get('category', '') in ['Medicine', 'Supplies'] && date is string
            && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && validExpiryCalendar(date.split('-')));
      }

      match /inventory/{itemId} {
        allow read: if isClinicMember(clinicId);
        allow create: if auditedMutation('inventory', itemId) && validInventoryExpiry(request.resource.data)
          && !request.resource.data.keys().hasAny(['billingStockEntryId']);
        allow update: if auditedMutation('inventory', itemId)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['expiryDate', 'category'])
            || validInventoryExpiry(request.resource.data))
          && (request.resource.data.get('billingStockEntryId', null) == resource.data.get('billingStockEntryId', null) || billingInventoryReference(itemId));
        allow delete: if auditedMutation('inventory', itemId) && resource.data.get('billingStockEntryId', null) == null;
      }

      function validInventoryImportReceipt(itemId) {
        let item = /databases/$(database)/documents/clinics/$(clinicId)/inventory/$(itemId);
        let audit = /databases/$(database)/documents/clinics/$(clinicId)/auditHeads/$(('inventory_' + itemId));
        let head = getAfter(audit).data;
        return canEditClinic(clinicId)
          && request.resource.data.keys().hasOnly(['batchId', 'at'])
          && request.resource.data.batchId is string
          && request.resource.data.batchId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
          && request.resource.data.at == request.time
          && !exists(item) && existsAfter(item)
          && head.action == 'create' && head.time == request.time && head.actorUid == request.auth.uid;
      }

      match /inventoryImportReceipts/{itemId} {
        allow read: if isClinicMember(clinicId) && get(clinicPath(clinicId)).data.get('aiEnabled', false) == true;
        allow create: if validInventoryImportReceipt(itemId);
        allow update, delete: if false;
      }

      // Firestore rules cannot loop over arbitrary lists, so the critical stock
      // invariant uses a bounded stockMoves list of at most two entries. Each
      // move must be applied to the matching inventory document in the same
      // audited transaction. Service/grooming lines never appear here.
      function stockMoveApplied(move) {
        let item = /databases/$(database)/documents/clinics/$(clinicId)/inventory/$(move.itemCode);
        return move is map
          && move.keys().hasOnly(['itemCode', 'quantity'])
          && move.itemCode is string && move.itemCode.size() > 0 && move.itemCode.size() <= 200
          && move.itemCode.matches('^[^/]+$')
          && move.quantity is int && move.quantity >= 1 && move.quantity <= 10000
          && exists(item) && existsAfter(item)
          && getAfter(item).data.get('billingStockEntryId', null) == get(item).data.get('billingStockEntryId', null)
          && getAfter(item).data.stock == get(item).data.stock - move.quantity
          && getAfter(item).data.get('revision', 0) == get(item).data.get('revision', 0) + 1;
      }

      function stockMovesApplied(data) {
        return data.stockMoves is list && data.stockMoves.size() <= 2
          && (data.stockMoves.size() < 1 || stockMoveApplied(data.stockMoves[0]))
          && (data.stockMoves.size() < 2 || stockMoveApplied(data.stockMoves[1]));
      }

      function consultationPatientMatches(data) {
        let patient = /databases/$(database)/documents/clinics/$(clinicId)/patients/$(data.patientId);
        return exists(patient)
          && data.patient == get(patient).data.name
          && data.client == get(patient).data.get('ownerName', '');
      }

      function consultationAppointmentMatches(data) {
        let appointment = /databases/$(database)/documents/clinics/$(clinicId)/appointments/$(data.appointmentId);
        return data.appointmentId == null
          || (data.appointmentId is string && data.appointmentId.size() > 0
            && exists(appointment) && get(appointment).data.patientId == data.patientId
            && get(appointment).data.status == 'completed');
      }

      function validStructuredConsultation(data) {
        return data.patientId is string && data.patientId.size() > 0 && data.patientId.size() <= 1500
          && data.patientId.matches('^[^/]+$')
          && data.keys().hasAll([
            'appointmentId', 'occurredAt', 'recordedAt', 'staffUid', 'staffName',
            'treatments', 'stockMoves'
          ])
          && data.stockMoves is list && data.stockMoves.size() <= 2
          && consultationPatientMatches(data)
          && (data.appointmentId == null
            || (data.appointmentId is string && data.appointmentId.size() > 0
              && consultationAppointmentMatches(data)));
      }

      function validConsultation(data, consultationId) {
        return data.id == consultationId
          && data.keys().hasAll(['id', 'date', 'client', 'patient', 'type', 'status', 'notes'])
          && data.keys().hasOnly([
            'id', 'revision', 'date', 'client', 'patient', 'type', 'status', 'notes',
            'patientId', 'appointmentId', 'occurredAt', 'recordedAt', 'staffUid',
            'staffName', 'treatments', 'stockMoves', 'historySortAt'
          ])
          && data.date is string && data.date.size() <= 40
          && data.client is string && data.client.size() <= 200
          && data.patient is string && data.patient.size() > 0 && data.patient.size() <= 150
          && data.type is string && data.type.size() > 0 && data.type.size() <= 60
          && data.status in ['Draft', 'Completed']
          && data.notes is string && data.notes.size() <= 5000
          && (
            !data.keys().hasAny(['patientId'])
            || (validStructuredConsultation(data)
              && data.occurredAt is timestamp
              && data.occurredAt >= timestamp.date(2000, 1, 1)
              && data.occurredAt <= request.time
              && data.recordedAt is timestamp
              && data.staffUid is string && data.staffUid == request.auth.uid
              && data.staffName is string && data.staffName.size() > 0 && data.staffName.size() <= 150
              && data.treatments is list && data.treatments.size() <= 12)
          );
      }

      function consultationHistoryState() {
        let marker = /databases/$(database)/documents/clinics/$(clinicId)/workspaceConfig/consultationHistory;
        return exists(marker) ? get(marker).data.state : '';
      }

      function hasConsultationHistorySort(data) {
        return data.keys().hasAny(['historySortAt']);
      }

      function validConsultationHistorySort(data) {
        return data.keys().hasAny(['patientId'])
          ? data.historySortAt == data.occurredAt
          : data.historySortAt == null || data.historySortAt is timestamp;
      }

      function acceptsNewConsultationSort(data) {
        return (data.keys().hasAny(['patientId']) && hasConsultationHistorySort(data) && validConsultationHistorySort(data))
          || (!(consultationHistoryState() in ['preparing', 'ready'])
            && (!hasConsultationHistorySort(data) || validConsultationHistorySort(data)));
      }

      function preservesConsultationHistory(before, after) {
        return hasConsultationHistorySort(before)
          ? (hasConsultationHistorySort(after) && after.historySortAt == before.historySortAt
            && !after.diff(before).affectedKeys().hasAny(['date', 'occurredAt', 'patientId']))
          : (!hasConsultationHistorySort(after) && consultationHistoryState() != 'ready');
      }

      match /workspaceConfig/consultationHistory {
        allow get: if isClinicMember(clinicId);
        // Only a brand-new empty clinic can enable chronological history as
        // part of its atomic Owner bootstrap. Existing clinics need migration.
        allow create: if signedIn()
          && !exists(clinicPath(clinicId))
          && getAfter(clinicPath(clinicId)).data.ownerId == request.auth.uid
          && getAfter(clinicPath(clinicId)).data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['state'])
          && request.resource.data.state == 'ready';
      }

      match /consultations/{consultationId} {
        allow read: if isClinicMember(clinicId);
        allow create: if validConsultation(request.resource.data, consultationId)
          && acceptsNewConsultationSort(request.resource.data)
          && (!request.resource.data.keys().hasAny(['patientId'])
            || (request.resource.data.recordedAt == request.time
              && stockMovesApplied(request.resource.data)))
          && auditedMutation('consultations', consultationId);
        allow update: if validConsultation(request.resource.data, consultationId)
          && preservesConsultationHistory(resource.data, request.resource.data)
          && (!hasConsultationHistorySort(request.resource.data) || validConsultationHistorySort(request.resource.data))
          && (!request.resource.data.keys().hasAny(['treatments'])
            || request.resource.data.treatments == resource.data.treatments)
          && (!request.resource.data.keys().hasAny(['stockMoves'])
            || request.resource.data.stockMoves == resource.data.stockMoves)
          && (!request.resource.data.keys().hasAny(['recordedAt'])
            || request.resource.data.recordedAt == resource.data.recordedAt)
          && auditedMutation('consultations', consultationId);
        allow delete: if false;
      }

      function validAppointment(data, appointmentId) {
        return data.keys().hasAll([
            'id', 'revision', 'patientId', 'patientName', 'ownerName', 'ownerContact', 'ownerEmail',
            'type', 'status', 'dueAt', 'durationMinutes', 'notes', 'occurredAt',
            'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
          ])
          && data.keys().hasOnly([
            'id', 'revision', 'patientId', 'patientName', 'ownerName', 'ownerContact', 'ownerEmail',
            'type', 'status', 'dueAt', 'durationMinutes', 'notes', 'occurredAt',
            'createdAt', 'updatedAt', 'createdBy', 'updatedBy', 'followUpContact'
          ])
          && data.id == appointmentId
          && data.patientId is string && data.patientId.size() > 0 && data.patientId.size() <= 1500
          && data.patientId.matches('^[^/]+$')
          && data.patientName is string && data.patientName.size() > 0 && data.patientName.size() <= 150
          && data.ownerName is string && data.ownerName.size() <= 200
          && data.ownerContact is string && data.ownerContact.size() <= 100
          && data.ownerEmail is string && data.ownerEmail.size() <= 254
          && data.type in ['Checkup', 'Vaccination', 'Deworming', 'Grooming', 'Surgery', 'Follow-up']
          && data.status in ['scheduled', 'completed', 'cancelled', 'no-show']
          && data.dueAt is timestamp
          && data.dueAt >= timestamp.date(2000, 1, 1) && data.dueAt < timestamp.date(2101, 1, 1)
          && data.durationMinutes is int && data.durationMinutes >= 5 && data.durationMinutes <= 480
          && data.notes is string && data.notes.size() <= 2000
          && ((data.status == 'completed' && data.occurredAt is timestamp
              && data.occurredAt >= timestamp.date(2000, 1, 1) && data.occurredAt <= request.time)
            || (data.status != 'completed' && data.occurredAt == null))
          && data.createdAt is timestamp && data.createdBy is string
          && data.updatedAt == request.time && data.updatedBy == request.auth.uid;
      }

      function appointmentPatientMatches(data) {
        let patient = /databases/$(database)/documents/clinics/$(clinicId)/patients/$(data.patientId);
        return exists(patient)
          && data.patientName == get(patient).data.name
          && data.ownerName == get(patient).data.get('ownerName', '')
          && data.ownerContact == get(patient).data.get('ownerContact', '')
          && data.ownerEmail == get(patient).data.get('ownerEmail', '');
      }

      function validFollowUpContactChange() {
        let before = resource.data;
        let next = request.resource.data;
        let contact = next.get('followUpContact', null);
        let previous = before.get('followUpContact', null);
        let nowMs = request.time.toMillis();
        let endMs = nowMs - ((nowMs + 28800000) % 86400000) + 86400000;
        return next.diff(before).affectedKeys().hasOnly(['revision', 'updatedAt', 'updatedBy', 'followUpContact'])
          && before.status == 'scheduled' && before.type == 'Follow-up' && before.dueAt.toMillis() < endMs
          && ((contact is map && contact.keys().hasOnly(['dueAt', 'contactedAt', 'contactedBy'])
              && contact.dueAt == before.dueAt && contact.contactedAt == request.time && contact.contactedBy == request.auth.uid
              && (previous == null || previous.dueAt != before.dueAt))
            || (!next.keys().hasAny(['followUpContact']) && previous is map && previous.dueAt == before.dueAt));
      }

      match /appointments/{appointmentId} {
        allow read: if isClinicMember(clinicId);
        allow create: if validAppointment(request.resource.data, appointmentId)
          && !request.resource.data.keys().hasAny(['followUpContact'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && appointmentPatientMatches(request.resource.data)
          && auditedMutation('appointments', appointmentId);
        allow update: if validAppointment(request.resource.data, appointmentId)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.patientId == resource.data.patientId
          && (validFollowUpContactChange() || (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['followUpContact'])
            && (appointmentPatientMatches(request.resource.data) || (
              !exists(/databases/$(database)/documents/clinics/$(clinicId)/patients/$(resource.data.patientId))
              && request.resource.data.patientName == resource.data.patientName
              && request.resource.data.ownerName == resource.data.ownerName
              && request.resource.data.ownerContact == resource.data.ownerContact
              && request.resource.data.ownerEmail == resource.data.ownerEmail
            ))
          ))
          && auditedMutation('appointments', appointmentId);
        // Cancel instead of erasing scheduling history.
        allow delete: if false;
      }

      // Pay rates are stored separately from the roster.
      match /staff/{staffId} {
        allow read: if isClinicMember(clinicId);
        allow create, update: if canEditClinic(clinicId)
          && request.resource.data.keys().hasAll(['name', 'kind', 'position', 'email', 'phone', 'active', 'hiredAt', 'notes'])
          && request.resource.data.keys().hasOnly(['name', 'kind', 'position', 'email', 'phone', 'active', 'hiredAt', 'notes', 'revision'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.kind in ['veterinarian', 'employee']
          && request.resource.data.position is string
          && request.resource.data.active is bool
          && auditedMutation('staff', staffId);
        allow delete: if auditedMutation('staff', staffId);
      }

      match /payProfiles/{staffId} {
        allow read: if isClinicMember(clinicId);
        allow create, update: if isClinicMember(clinicId)
          && request.resource.data.keys().hasOnly(['payBasis', 'rate', 'updatedAt', 'revision'])
          && request.resource.data.payBasis in ['daily', 'monthly']
          && request.resource.data.rate is number && request.resource.data.rate >= 0
          && request.resource.data.updatedAt == request.time
          && auditedMutation('payProfiles', staffId);
        allow delete: if auditedMutation('payProfiles', staffId);
      }

      function openPayrollPeriodAfter(periodId) {
        return getAfter(/databases/$(database)/documents/clinics/$(clinicId)/payrollPeriods/$(periodId)).data.status == 'open';
      }

      function payrollLedgerPath(entryId) {
        return /databases/$(database)/documents/clinics/$(clinicId)/payrollLedger/$(entryId);
      }

      function payrollPayoutLimitPath(periodId, staffId) {
        return /databases/$(database)/documents/clinics/$(clinicId)/payrollPeriods/$(periodId)/payoutLimits/$(staffId);
      }

      function payrollSummaryPath(periodId) {
        return /databases/$(database)/documents/clinics/$(clinicId)/payrollPeriods/$(periodId)/payoutState/summary;
      }

      function unpaidPayrollCount(path) {
        return exists(path) ? get(path).data.unpaidCount : 0;
      }

      function changesUnpaidPayrollCount(periodId, staffId, delta) {
        let path = payrollSummaryPath(periodId);
        let summary = getAfter(path).data;
        return summary.lastStaffId == staffId
          && summary.unpaidCount == unpaidPayrollCount(path) + delta;
      }

      function payrollReconciliationPath(staffId) {
        return /databases/$(database)/documents/clinics/$(clinicId)/payrollReconciliations/$(staffId);
      }

      function reconciledPayrollAmount(path) {
        return exists(path) ? get(path).data.appliedMinor : 0;
      }

      function includesPayrollReconciliation(periodId, staffId, amount) {
        let path = payrollReconciliationPath(staffId);
        let next = getAfter(path).data;
        return next.lastPeriodId == periodId && next.appliedMinor == reconciledPayrollAmount(path) + amount;
      }

      function validPayrollPayout(entryId, entry) {
        let path = payrollPayoutLimitPath(entry.periodId, entry.staffId);
        let before = get(path).data;
        let after = getAfter(path).data;
        return entry.direction == 'out'
          && after.lastEntryId == entryId
          && after.paidMinor > before.paidMinor
          && entry.amount == (after.paidMinor - before.paidMinor) / 100.0;
      }

      match /payrollPeriods/{periodId} {
        allow read: if isClinicMember(clinicId);
        allow create: if isClinicMember(clinicId)
          && request.resource.data.keys().hasAll(['startDate', 'endDate', 'status', 'createdAt'])
          && request.resource.data.keys().hasOnly(['startDate', 'endDate', 'status', 'createdAt', 'revision'])
          && request.resource.data.startDate is string
          && request.resource.data.endDate is string
          && request.resource.data.endDate >= request.resource.data.startDate
          && request.resource.data.status == 'open'
          && request.resource.data.createdAt == request.time
          && auditedMutation('payrollPeriods', periodId);
        allow update: if isClinicMember(clinicId)
          && resource.data.status == 'open'
          && request.resource.data.status == 'closed'
          && request.resource.data.closedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt', 'revision'])
          && (!existsAfter(payrollSummaryPath(periodId)) || getAfter(payrollSummaryPath(periodId)).data.unpaidCount == 0)
          && auditedMutation('payrollPeriods', periodId);
        allow delete: if false;

        match /payoutState/{summaryId} {
          function validUnpaidCount(next) {
            let summary = payrollSummaryPath(periodId);
            let path = payrollPayoutLimitPath(periodId, next.lastStaffId);
            let limit = getAfter(path).data;
            let count = unpaidPayrollCount(summary);
            return (!exists(path) && limit.paidMinor < limit.approvedMinor && next.unpaidCount == count + 1)
              || (exists(path) && get(path).data.paidMinor < limit.approvedMinor
                && limit.paidMinor == limit.approvedMinor && next.unpaidCount == count - 1);
          }

          allow get: if summaryId == 'summary' && isClinicMember(clinicId);
          allow create, update: if summaryId == 'summary' && isClinicMember(clinicId)
            && openPayrollPeriodAfter(periodId)
            && request.resource.data.keys().hasOnly(['unpaidCount', 'lastStaffId'])
            && request.resource.data.lastStaffId is string
            && request.resource.data.unpaidCount is int
            && request.resource.data.unpaidCount >= 0
            && validUnpaidCount(request.resource.data);
          allow list, delete: if false;
        }

        match /payoutLimits/{staffId} {
          function recordsNewPayout(next) {
            let path = payrollLedgerPath(next.lastEntryId);
            let entry = getAfter(path).data;
            return !exists(path)
              && entry.type == 'payout'
              && entry.periodId == periodId
              && entry.staffId == staffId
              && entry.createdAt == request.time;
          }

          allow read: if isClinicMember(clinicId);
          // Members confirm the approved total and reconcile earlier payments
          // once. Firestore enforces each subsequent increment against it.
          allow create: if isClinicMember(clinicId)
            && openPayrollPeriodAfter(periodId)
            && exists(/databases/$(database)/documents/clinics/$(clinicId)/staff/$(staffId))
            && request.resource.data.keys().hasOnly(['approvedMinor', 'paidMinor', 'unassignedPaidMinor', 'lastEntryId', 'confirmedBy', 'confirmedAt'])
            && request.resource.data.approvedMinor is int
            && request.resource.data.approvedMinor > 0
            && request.resource.data.approvedMinor <= 9007199254740991
            && request.resource.data.paidMinor is int
            && request.resource.data.paidMinor >= 0
            && request.resource.data.paidMinor <= request.resource.data.approvedMinor
            && request.resource.data.unassignedPaidMinor is int
            && request.resource.data.unassignedPaidMinor >= 0
            && request.resource.data.unassignedPaidMinor <= request.resource.data.paidMinor
            && (request.resource.data.unassignedPaidMinor == 0
              || includesPayrollReconciliation(periodId, staffId, request.resource.data.unassignedPaidMinor))
            && (request.resource.data.paidMinor == request.resource.data.approvedMinor
              || changesUnpaidPayrollCount(periodId, staffId, 1))
            && request.resource.data.lastEntryId == ''
            && request.resource.data.confirmedBy == request.auth.uid
            && request.resource.data.confirmedAt == request.time;
          allow update: if isClinicMember(clinicId)
            && openPayrollPeriodAfter(periodId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidMinor', 'lastEntryId'])
            && request.resource.data.paidMinor is int
            && request.resource.data.paidMinor > resource.data.paidMinor
            && request.resource.data.paidMinor <= resource.data.approvedMinor
            && (request.resource.data.paidMinor < resource.data.approvedMinor
              || changesUnpaidPayrollCount(periodId, staffId, -1))
            && request.resource.data.lastEntryId is string
            && request.resource.data.lastEntryId.size() > 0
            && recordsNewPayout(request.resource.data);
          allow delete: if false;
        }
      }

      match /payrollReconciliations/{staffId} {
        function recordsLegacyReconciliation(next) {
          let path = payrollPayoutLimitPath(next.lastPeriodId, staffId);
          let limit = getAfter(path).data;
          return !exists(path) && limit.unassignedPaidMinor > 0
            && next.appliedMinor == reconciledPayrollAmount(payrollReconciliationPath(staffId)) + limit.unassignedPaidMinor;
        }

        allow get: if isClinicMember(clinicId);
        allow create, update: if isClinicMember(clinicId)
          && request.resource.data.keys().hasOnly(['appliedMinor', 'lastPeriodId'])
          && request.resource.data.lastPeriodId is string
          && request.resource.data.appliedMinor is int
          && request.resource.data.appliedMinor <= 9007199254740991
          && recordsLegacyReconciliation(request.resource.data);
        allow list, delete: if false;
      }

      // Head of the ledger hash chain. Mutable metadata, but the entries
      // themselves stay immutable, so tampering with it breaks verification.
      match /payrollMeta/{metaId} {
        allow read: if isClinicMember(clinicId);
        allow create, update: if isClinicMember(clinicId)
          && request.resource.data.keys().hasAll(['seq', 'hash'])
          && request.resource.data.keys().hasOnly(['seq', 'hash', 'updatedAt'])
          && request.resource.data.seq is int
          && request.resource.data.seq > 0
          && request.resource.data.hash is string;
        allow delete: if false;
      }

      // Append-only payroll ledger. Updates and deletes are always denied; the
      // app additionally verifies a SHA-256 hash chain across all entries.
      match /payrollLedger/{entryId} {
        allow read: if isClinicMember(clinicId);
        allow create: if isClinicMember(clinicId)
          && request.resource.data.keys().hasAll([
            'seq', 'type', 'direction', 'staffId', 'staffName', 'amount',
            'periodId', 'note', 'createdBy', 'prevHash', 'hash', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'seq', 'type', 'direction', 'staffId', 'staffName', 'amount',
            'periodId', 'note', 'createdBy', 'prevHash', 'hash', 'createdAt'
          ])
          && request.resource.data.seq is int
          && request.resource.data.seq > 0
          && request.resource.data.type in ['advance', 'repayment', 'payout', 'adjustment']
          && request.resource.data.direction in ['in', 'out']
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.staffId is string
          && request.resource.data.staffName is string
          && request.resource.data.note is string
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.prevHash is string
          && request.resource.data.hash is string
          && request.resource.data.hash.size() == 64
          && (request.resource.data.type != 'payout'
            || (request.resource.data.periodId is string && validPayrollPayout(entryId, request.resource.data)));
        allow update, delete: if false;
      }
    }

    // A user's clinic-picker index is private to that signed-in user.
    match /users/{uid} {
      allow read, write: if false;

      match /clinics/{clinicId} {
        allow get, list: if signedIn() && request.auth.uid == uid;

        allow create: if (
          signedIn()
          && uid == request.auth.uid
          && request.resource.data.keys().hasAll(['clinicId', 'clinicName', 'role', 'joinedAt'])
          && request.resource.data.keys().hasOnly(['clinicId', 'clinicName', 'role', 'joinedAt'])
          && request.resource.data.clinicId == clinicId
          && request.resource.data.clinicName is string
          && request.resource.data.role == 'owner'
          && request.resource.data.joinedAt == request.time
          && validOwnerIndexBootstrap(clinicId, uid)
        ) || (
          signedIn()
          && uid == request.auth.uid
          && request.resource.data.keys().hasAll(['clinicId', 'clinicName', 'role', 'joinedAt', 'invitationId'])
          && request.resource.data.keys().hasOnly(['clinicId', 'clinicName', 'role', 'joinedAt', 'invitationId'])
          && request.resource.data.clinicId == clinicId
          && request.resource.data.clinicName is string
          && request.resource.data.role == 'member'
          && request.resource.data.joinedAt == request.time
          && validInviteClaim(clinicId, uid, request.resource.data.invitationId)
          && get(invitationPath(clinicId, request.resource.data.invitationId)).data.clinicName
            == request.resource.data.clinicName
        );

        allow update: if false;

        allow delete: if isClinicOwner(clinicId)
          && uid != request.auth.uid
          && !existsAfter(memberPath(clinicId, uid));
      }
    }

    // Everything not explicitly allowed above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
