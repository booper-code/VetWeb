# Cloudflare Worker that stores patient images in R2.
# See workers/image-service/README.md for setup and deployment.
# Leave empty to keep the legacy inline base64 behaviour.
NEXT_PUBLIC_IMAGE_WORKER_URL=

# Optional, trusted read-only VetWeb assistant Worker origin (not an AI provider).
NEXT_PUBLIC_ASSISTANT_TOOLS_URL=
# Enable only after the matching inventory import receipt rules are installed.
NEXT_PUBLIC_CSV_IMPORT_RECEIPTS=
